{
  "name": "bth-catalog-system",
  "version": "0.1.0",
  "description": "BTH Catalog System - Laravel + Vue.js + Inertia",
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "scripts": {
    "dev-vite": "vite",
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js database.sqlite",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@inertiajs/vue3": "^3.1.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-vue": "^6.0.7",
    "axios": "^1.16.1",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "http-proxy-middleware": "^4.0.0",
    "laravel-vite-plugin": "^3.1",
    "lucide-react": "^0.546.0",
    "lucide-vue-next": "^0.475.0",
    "motion": "^12.23.24",
    "vite": "^8.0.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.28.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^8.0.0"
  },
  "author": {
